# ==========================================
# School Examination System - Server Env Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=exam_user
DB_PASSWORD=ExamSystem@123
DB_NAME=school_exam_system
DB_CONNECTION_LIMIT=10

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_string_in_production
JWT_EXPIRES_IN=24h

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
